# ══════════════════════════════════════════════════════════════
#  ES Print Media Inc. Portal — Environment Configuration
#  Copy this file to .env.local and fill in the values.
# ══════════════════════════════════════════════════════════════

# ── AUTH MODE ─────────────────────────────────────────────────
# "true"  = dev mode with mock users (no AWS needed) — for local dev
# "false" = production mode using AWS Cognito
AUTH_DEV_MODE=true

# ── AWS COGNITO (authentication) ──────────────────────────────
# Get these from: AWS Console > Cognito > User Pools > (your pool)
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── AWS RDS PostgreSQL (database) ─────────────────────────────
# Get the endpoint from: AWS Console > RDS > Databases > (your db) > Connectivity
# Option 1 — full connection string (recommended):
DATABASE_URL=postgresql://USER:PASSWORD@your-db.xxxxx.ap-southeast-1.rds.amazonaws.com:5432/esprint_portal
DB_SSL=true
DB_POOL_MAX=10

# Option 2 — individual parts (comment out DATABASE_URL above to use these):
# DB_HOST=your-db.xxxxx.ap-southeast-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=esprint_portal
# DB_USER=portal_admin
# DB_PASSWORD=your-strong-password

# ── AWS S3 (file storage) ─────────────────────────────────────
# Get from: AWS Console > S3 > (your bucket)
S3_REGION=ap-southeast-1
S3_BUCKET=esprint-portal-files
# For local dev, provide IAM keys. In production on Amplify/EC2 use an IAM role instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── APP ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SUPABASE SYNC (for /api/admin/sync) ───────────────────────
# Source Supabase project for one-way sync to RDS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Secret token for the /api/admin/sync endpoint.
SYNC_SECRET=sync-esprint-2026

# ── S3 ATTACHMENTS (client file uploads on Reconstruct report) ─
S3_REGION=ap-southeast-1
S3_BUCKET=esprint-portal-attachments
